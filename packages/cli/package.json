{
  "name": "@mide6x/create-stackforge",
  "version": "0.1.0-alpha.1",
  "license": "MPL-2.0",
  "description": "Create modern full-stack projects with StackForge",
  "type": "module",
  "bin": {
    "create-stackforge": "./dist/index.js",
    "stackforge": "./dist/index.js"
