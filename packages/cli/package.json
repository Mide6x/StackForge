    "@stackforge/provider-fastapi": "0.1.0-alpha.1",
    "@stackforge/provider-mongodb": "0.1.0-alpha.1",
    "@stackforge/provider-nextjs": "0.1.0-alpha.1",
    "@stackforge/provider-postgres": "0.1.0-alpha.1",
    "@stackforge/provider-react": "0.1.0-alpha.1",
    "@stackforge/provider-springboot": "0.1.0-alpha.1",
    "@stackforge/provider-supabase": "0.1.0-alpha.1",
    "@stackforge/provider-vue": "0.1.0-alpha.1",
    "esbuild": "^0.28.1"
  }
