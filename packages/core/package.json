{
  "name": "@stackforge/core",
  "version": "0.1.0",
  "description": "Core packages for stackforge, this contains the interfaces that every provider will follow",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
