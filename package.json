{
  "name": "stackforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An extensible CLI for scaffolding modern application stacks",
  "workspaces": [
    "packages/*",
    "providers/*",
    "integrations/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@stackforge/core && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=create-stackforge",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm test --workspace=@stackforge/core && npm test --workspace=create-stackforge",
    "test:integration": "npm test --workspace=@stackforge/integrations-built-in && npm test --workspace=@stackforge/integration-nextjs-express-postgres",
    "test:generated": "node --import tsx --test tests/generated/*.test.ts",
    "test:generated:e2e": "node --import tsx --test tests/generated/*e2e*.test.ts",
    "test:docker": "node --import tsx --test tests/docker/*.test.ts",
    "test:all": "npm run build && npm test && npm run test:generated && npm run test:docker",
    "validate:governance": "node scripts/validate-governance.mjs",
    "create": "npm run dev --workspace=create-stackforge"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "fullstack",
    "project-generator"
  ],
  "author": "Olumide Adewole",
  "license": "MPL-2.0",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
