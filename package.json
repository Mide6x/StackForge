{
  "name": "stackforge",
  "version": "0.1.0",
  "private": true,
  "description": "An extensible CLI for scaffolding modern application stacks",
  "workspaces": [
    "packages/*",
    "providers/*",
    "integrations/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@stackforge/core && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=create-stackforge",
    "test": "npm run test --workspaces --if-present",
    "create": "npm run dev --workspace=create-stackforge"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "fullstack",
    "project-generator"
  ],
  "author": "Olumide Adewole",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
